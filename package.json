{
  "name": "ceylon-events",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "reset:db": "tsx scripts/reset-db.ts",
    "seed": "tsx scripts/seed.ts",
    "reset-and-seed": "pnpm reset:db && pnpm seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "bcryptjs": "^2.4.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "bcrypt"]
  }
}
