# Copy to .env and adjust for local dev. Docker Compose reads this file
# automatically. All secrets here are dev-only defaults, never use them
# in a real deployment.

# --- Postgres (single instance, one database per service) ---
POSTGRES_USER=ceylon
POSTGRES_PASSWORD=ceylon_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=ceylon
RABBITMQ_DEFAULT_PASS=ceylon_dev_password
RABBITMQ_URL=amqp://ceylon:ceylon_dev_password@rabbitmq:5672

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=ceylon
MINIO_ROOT_PASSWORD=ceylon_dev_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MEDIA_BUCKET=ceylon-media

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@ceylonevents.com
PGADMIN_DEFAULT_PASSWORD=ceylon_dev_password
PGADMIN_PORT=5050

# --- JWT (shared across all services that verify tokens) ---
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# --- Service-to-service auth (e.g. Payment Service confirming an order) ---
INTERNAL_SERVICE_SECRET=dev_internal_secret_change_me

# --- PayHere (sandbox) ---
# Replace with your own PayHere sandbox merchant credentials
# (https://www.payhere.lk/support/merchant-registration) to actually test
# a checkout — these placeholders will authenticate against nothing.
PAYHERE_MERCHANT_ID=your_sandbox_merchant_id
PAYHERE_MERCHANT_SECRET=your_sandbox_merchant_secret
PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout
PAYHERE_CURRENCY=LKR

# --- Service ports (host-side) ---
API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
RESTAURANT_SERVICE_PORT=3002
MEDIA_SERVICE_PORT=3003
VENUE_SERVICE_PORT=3004
EVENT_SERVICE_PORT=3005
ORDER_SERVICE_PORT=3006
PAYMENT_SERVICE_PORT=3007
CHECKIN_SERVICE_PORT=3008
FOOD_ORDER_SERVICE_PORT=3009
OFFERS_SERVICE_PORT=3010

# --- Seat holds (Venue/Seating Service) ---
SEAT_HOLD_TTL_SECONDS=300

# --- Food pre-orders (Food Order Service) ---
FOOD_ORDER_EDIT_CUTOFF_MINUTES=120

# --- Web portal ports (host-side) ---
WEB_ADMIN_PORT=4000
WEB_USER_PORT=4001
WEB_RESTAURANT_PORT=4002

NODE_ENV=development
